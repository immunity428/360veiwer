{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vrmap スポット定義",
  "description": "会場マップのエリア・座席・画像・ピン座標をまとめて管理するファイル。VS Codeで開くと各項目の説明と入力チェックが表示されます。",
  "type": "object",
  "required": ["map", "areas"],
  "additionalProperties": false,
  "definitions": {
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "imagePath": {
      "type": "string",
      "description": "public/ からのパス（例: images/areas/foodcourt.jpg）",
      "pattern": "^(?!/)[^\\s]+\\.(png|jpe?g|webp)$"
    }
  },
  "properties": {
    "$schema": { "type": "string" },
    "map": {
      "type": "object",
      "description": "トップページの会場マップ",
      "required": ["image", "alt"],
      "additionalProperties": false,
      "properties": {
        "image": { "$ref": "#/definitions/imagePath", "description": "会場マップ画像（public/ からのパス）" },
        "alt": { "type": "string", "description": "画像の代替テキスト" },
        "credit": { "type": "string", "description": "マップ下に表示する出典表記" }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "x", "y", "description", "detailMap", "seats"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "英小文字・数字・ハイフンのみ。全エリア・全座席で重複不可" },
          "label": { "type": "string", "minLength": 1, "description": "ピンに表示するエリア名" },
          "x": { "$ref": "#/definitions/percent", "description": "会場マップ上のピン中心の横位置（左端0〜右端100の%）" },
          "y": { "$ref": "#/definitions/percent", "description": "会場マップ上のピン中心の縦位置（上端0〜下端100の%）" },
          "description": { "type": "string", "description": "拡大マップ上部に表示する説明文" },
          "detailMap": {
            "oneOf": [{ "$ref": "#/definitions/imagePath" }, { "type": "null" }],
            "description": "エリアの拡大マップ画像。未作成なら null（座席一覧だけ表示されます）"
          },
          "detailMapCredit": { "type": "string", "description": "拡大マップ下に表示する出典表記" },
          "seats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "x", "y", "panorama", "ticketUrl"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "英小文字・数字・ハイフンのみ。全エリア・全座席で重複不可" },
                "label": { "type": "string", "minLength": 1, "description": "ピンに表示する座席名" },
                "x": { "$ref": "#/definitions/percent", "description": "拡大マップ上のピン中心の横位置（%）" },
                "y": { "$ref": "#/definitions/percent", "description": "拡大マップ上のピン中心の縦位置（%）" },
                "description": { "type": "string", "description": "360°ビュー下に表示する補足（任意）" },
                "panorama": {
                  "oneOf": [{ "$ref": "#/definitions/imagePath" }, { "type": "null" }],
                  "description": "360°画像（正距円筒図法・2:1）。未撮影なら null で「撮影準備中」表示"
                },
                "ticketUrl": {
                  "oneOf": [{ "type": "string", "pattern": "^https://" }, { "type": "null" }],
                  "description": "チケット購入ページのURL。未定なら null でボタン非表示"
                },
                "view": {
                  "type": "object",
                  "description": "360°ビューを開いたときの初期視点",
                  "additionalProperties": false,
                  "properties": {
                    "pitch": { "type": "number", "minimum": -90, "maximum": 90, "description": "上下の角度（上が+）" },
                    "yaw": { "type": "number", "minimum": -180, "maximum": 180, "description": "左右の向き（右が+）" },
                    "hfov": { "type": "number", "minimum": 30, "maximum": 120, "description": "視野角（小さいほどズーム）" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
